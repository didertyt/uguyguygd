    local isFlinging = false
    local function performFling(target: Player, duration: number?)
        if isFlinging then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return end
        if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then return end

        isFlinging = true
        local flingDuration = duration or 10
        local startCFrame = root.CFrame

        local noclipConn = RunService.Stepped:Connect(function()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        local startTime = os.clock()
        while os.clock() - startTime < flingDuration do
            if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then break end
            if not char or not root or not hum or hum.Health <= 0 then break end

            local targetRoot = target.Character.HumanoidRootPart
            local angle = (os.clock() * 50) % (math.pi * 2)
            local offset = Vector3.new(math.cos(angle) * 3, 0, math.sin(angle) * 3)

            root.CFrame = targetRoot.CFrame + offset
            root.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
            root.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
            task.wait()
        end

        noclipConn:Disconnect()
        if root and hum and hum.Health > 0 then
