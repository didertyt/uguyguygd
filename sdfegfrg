local function spawnDustParticle(startPos: Vector2, targetPos: Vector2, duration: number, isReversed: boolean)
    local pSize = math.random(5, 10)
    local p = Instance.new("Frame")
    p.Size = UDim2.new(0, pSize, 0, pSize)
    p.AnchorPoint = Vector2.new(0.5, 0.5)
    p.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
    p.BackgroundColor3 = dustColors[math.random(1, #dustColors)]
    p.BorderSizePixel = 0
    p.BackgroundTransparency = 0.05
    p.ZIndex = 250
    p.Parent = ScreenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = p

    task.spawn(function()
        local startTime = os.clock()
        local curveOffset = Vector2.new(math.random(-80, 80), math.random(-80, 80))

        while os.clock() - startTime < duration do
            local alpha = (os.clock() - startTime) / duration
            local currentPos = (1 - alpha) * (1 - alpha) * startPos + 2 * (1 - alpha) * alpha * (startPos + curveOffset) + alpha * alpha * targetPos
            p.Position = UDim2.new(0, currentPos.X, 0, currentPos.Y)
            p.BackgroundTransparency = isReversed and (alpha * 0.95) or (0.05 + alpha * 0.95)
            p.Size = UDim2.new(0, math.max(1, pSize * (1 - alpha)), 0, math.max(1, pSize * (1 - alpha)))
            RunService.RenderStepped:Wait()
        end
        p:Destroy()
    end)
end

local function toggleMenu()
    if isAnimatingMenu then return end
    isAnimatingMenu = true
    isMenuOpen = not isMenuOpen

    local sScale = (uiScale and uiScale.Scale) or 1
    local btnCenter = ToggleButton.AbsolutePosition + (ToggleButton.AbsoluteSize / 2)
    btnCenter = btnCenter / sScale

    if isMenuOpen then
        playSound("rbxassetid://9114221317", 0.35, 1.2)
        MainFrame.Visible = true

        local targetPos = savedPosition
        local targetSize = savedSize
        local targetScale = savedScale

        MainFrame.Position = UDim2.new(0, btnCenter.X, 0, btnCenter.Y)
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.BackgroundTransparency = 1
        frameContentScale.Scale = 0.03

        -- Замедленный выброс пыли из кнопки
        for i = 1, 55 do
            local angle = math.random() * math.pi * 2
            local dist = math.random(80, 260)
            local endPoint = btnCenter + Vector2.new(math.cos(angle) * dist, math.sin(angle) * dist)
            spawnDustParticle(btnCenter, endPoint, math.random(70, 110) / 100, true)
        end

        -- Замедленные твины (0.85s)
        TweenService:Create(frameContentScale, TweenInfo.new(0.85, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Scale = targetScale
        }):Play()

        TweenService:Create(MainFrame, TweenInfo.new(0.85, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = targetPos,
            Size = targetSize,
            BackgroundTransparency = 0.35
        }):Play()

        sendNotification("Menu Opened")
        task.wait(0.86)
        isAnimatingMenu = false
    else
        playSound("rbxassetid://9114221317", 0.35, 0.7)
        sendNotification("Menu Closed")

        local frameAbsPos = MainFrame.AbsolutePosition / sScale
        local frameAbsSize = MainFrame.AbsoluteSize / sScale

        -- Замедленный рой частиц пыли, летящий в круглую кнопку
        for i = 1, 65 do
            local spawnX = frameAbsPos.X + math.random(0, frameAbsSize.X)
            local spawnY = frameAbsPos.Y + math.random(0, frameAbsSize.Y)
            spawnDustParticle(Vector2.new(spawnX, spawnY), btnCenter, math.random(65, 105) / 100, false)
        end

        -- Замедленное сворачивание (0.8s)
        TweenService:Create(frameContentScale, TweenInfo.new(0.8, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
            Scale = 0.01
        }):Play()

        local tw = TweenService:Create(MainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
            Position = UDim2.new(0, btnCenter.X, 0, btnCenter.Y),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        })
        tw:Play()
        tw.Completed:Wait()

        MainFrame.Visible = false
        MainFrame.Position = savedPosition
        MainFrame.Size = savedSize
        frameContentScale.Scale = savedScale

        isAnimatingMenu = false
    end
end

