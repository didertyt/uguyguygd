    local function startOrbitKillProcess()
        if not selectedFarmTarget then
            sendNotification("⚠️ Select target from list first!")
            return
        end

        if infiniteKillEnabled then
            stopInfiniteKill()
            KillActionBtn.Text = "⚔️ TARGET KILL: OFF"
