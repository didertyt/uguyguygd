-- ПЕРЕМЕЩЕНИЕ ТОЛЬКО ЗА ВЕРХНЮЮ ЧАСТЬ (TOPBAR)
-- ==============================================================================
local draggingTop = false
local dragStartPos = nil
local frameStartPos = nil
local dragInputRef = nil

TopBar.InputBegan:Connect(function(input)
    if isResizing then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local btnAbsPos = CloseBtn.AbsolutePosition
        local btnAbsSize = CloseBtn.AbsoluteSize
        -- Проверка: если нажали на крестик закрытия, окно не перетаскивается
        if mousePos.X >= btnAbsPos.X and mousePos.X <= btnAbsPos.X + btnAbsSize.X and
           mousePos.Y >= btnAbsPos.Y and mousePos.Y <= btnAbsPos.Y + btnAbsSize.Y then
            return
        end

        draggingTop = true
        dragStartPos = input.Position
        frameStartPos = MainFrame.Position
        dragInputRef = input

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingTop = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingTop and (input == dragInputRef or input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local scale = (uiScale and uiScale.Scale) or 1
        local delta = (input.Position - dragStartPos) / scale
        
        MainFrame.Position = UDim2.new(
            frameStartPos.X.Scale,
            frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,
            frameStartPos.Y.Offset + delta.Y
        )
        savedPosition = MainFrame.Position
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingTop = false
    end
end)

