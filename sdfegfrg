-- ==============================================================================
-- RESIZE HANDLES (УДАЛЕНЫ ВОЗЛЕ КРЕСТИКА И В НИЖНЕМ ЛЕВОМ УГЛУ)
-- ==============================================================================
local MIN_WIDTH, MIN_HEIGHT = 320, 230
local isResizing = false

local savedSize = MainFrame.Size
local savedPosition = MainFrame.Position
local savedScale = 1

-- MOBILE TOUCH SAFETY: keep the resize state tied to the exact finger/input.
local activeResizeInput = nil
local activeResizeDragConn = nil
local activeResizeStateConn = nil
local activeResizeReleaseConn = nil

local function stopResize()
    if activeResizeDragConn then
        activeResizeDragConn:Disconnect()
        activeResizeDragConn = nil
    end
    if activeResizeStateConn then
        activeResizeStateConn:Disconnect()
        activeResizeStateConn = nil
    end
    if activeResizeReleaseConn then
        activeResizeReleaseConn:Disconnect()
        activeResizeReleaseConn = nil
    end
    activeResizeInput = nil
    isResizing = false
end

local function makeCornerResizeHandle(name, anchor, pos, xDir, yDir, iconSymbol)
    local handle = Instance.new("ImageButton")
    handle.Name = name
    handle.Size = UDim2.new(0, 32, 0, 32)
    handle.AnchorPoint = anchor
    handle.Position = pos
    handle.BackgroundTransparency = 1
    handle.ZIndex = 120
    handle.Active = true
    handle.Parent = MainFrame

    local marker = Instance.new("TextLabel")
    marker.Size = UDim2.new(1, 0, 1, 0)
    marker.BackgroundTransparency = 1
    marker.Text = iconSymbol
    marker.Font = Enum.Font.GothamBold
    marker.TextSize = 14
    marker.TextColor3 = Color3.fromRGB(190, 90, 255)
    marker.TextTransparency = 0.3
    marker.ZIndex = 121
    marker.Parent = handle

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        -- Stop any previous resize first. This is important on touch devices
        -- where a second touch can arrive before the previous InputEnded.
        stopResize()
        isResizing = true
        activeResizeInput = input

        local startMousePos = Vector2.new(input.Position.X, input.Position.Y)
        local currentScaleRatio = frameContentScale.Scale
        local initialPxW = MainFrame.Size.X.Offset * currentScaleRatio
        local initialPxH = MainFrame.Size.Y.Offset * currentScaleRatio
        local startPos = MainFrame.Position
        local screenScale = (uiScale and uiScale.Scale) or 1

        activeResizeDragConn = UserInputService.InputChanged:Connect(function(moveInput)
            if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement and moveInput.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            -- On touch, only the finger that started resizing may control it.
            if input.UserInputType == Enum.UserInputType.Touch and moveInput ~= input then
                return
            end

            local currentMousePos = Vector2.new(moveInput.Position.X, moveInput.Position.Y)
            local delta = (currentMousePos - startMousePos) / screenScale

            local newW = math.max(MIN_WIDTH, initialPxW + (delta.X * xDir))
            local newH = math.max(MIN_HEIGHT, initialPxH + (delta.Y * yDir))

            local scaleRatio = math.min(newW / BASE_WIDTH, newH / BASE_HEIGHT)
            frameContentScale.Scale = scaleRatio
            savedScale = scaleRatio

            local finalOffsetW = newW / scaleRatio
            local finalOffsetH = newH / scaleRatio
            MainFrame.Size = UDim2.new(0, finalOffsetW, 0, finalOffsetH)
            savedSize = MainFrame.Size

            local shiftX = (xDir == -1) and (initialPxW - newW) or 0
            local shiftY = (yDir == -1) and (initialPxH - newH) or 0

            if xDir == -1 or yDir == -1 then
                MainFrame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + shiftX,
                    startPos.Y.Scale,
                    startPos.Y.Offset + shiftY
                )
                savedPosition = MainFrame.Position
            end
        end)

        -- Primary release handler: tied to the exact input that started resize.
        activeResizeStateConn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                stopResize()
            end
        end)

        -- Fallback for executors/devices that don't reliably propagate Changed.
        activeResizeReleaseConn = UserInputService.InputEnded:Connect(function(endInput)
            if endInput == input then
                stopResize()
            end
        end)
    end)
end

