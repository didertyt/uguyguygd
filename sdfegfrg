local function tryTargetFromScreen(x: number, y: number)
    local unitRay = Camera:ScreenPointToRay(x, y)
    if not unitRay then return nil end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end

    local rayResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1500, raycastParams)
    local hitPart = rayResult and rayResult.Instance

    if not hitPart then
        local sphereCastResult = workspace:Spherecast(unitRay.Origin, 1.8, unitRay.Direction * 1500, raycastParams)
        if sphereCastResult then
            hitPart = sphereCastResult.Instance
        end
    end

    if hitPart then
        local model = hitPart:FindFirstAncestorOfClass("Model")
        while model and model ~= workspace do
            local player = Players:GetPlayerFromCharacter(model)
            if player and player ~= LocalPlayer then
                return player
            end
            model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
        end
    end
    return nil
end

