local antiLagEnabled = false
local antiLagConnection = nil
local antiLagCache = {
    materials = {},
    shadows = {},
    effects = {},
    lighting = {}
}

local function setAntiLagState(state: boolean)
    antiLagEnabled = state
    if state then
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                antiLagCache.lighting[effect] = effect.Enabled
                effect.Enabled = false
            end
        end

        local function optimizePart(part)
            if part:IsA("BasePart") then
                if not antiLagCache.materials[part] then
                    antiLagCache.materials[part] = part.Material
                end
                if not antiLagCache.shadows[part] then
                    antiLagCache.shadows[part] = part.CastShadow
                end
                part.Material = Enum.Material.SmoothPlastic
                part.CastShadow = false
            elseif part:IsA("ParticleEmitter") or part:IsA("Trail") or part:IsA("Smoke") or part:IsA("Fire") or part:IsA("Sparkles") then
                if not antiLagCache.effects[part] then
                    antiLagCache.effects[part] = part.Enabled
                end
                part.Enabled = false
            end
        end

        for _, desc in ipairs(workspace:GetDescendants()) do
            optimizePart(desc)
        end

        antiLagConnection = workspace.DescendantAdded:Connect(function(desc)
            if antiLagEnabled then
                optimizePart(desc)
            end
        end)
    else
        if antiLagConnection then
            antiLagConnection:Disconnect()
            antiLagConnection = nil
        end

        for part, mat in pairs(antiLagCache.materials) do
            if part and part.Parent then
                pcall(function() part.Material = mat end)
            end
        end
        table.clear(antiLagCache.materials)

        for part, shadow in pairs(antiLagCache.shadows) do
            if part and part.Parent then
                pcall(function() part.CastShadow = shadow end)
            end
        end
        table.clear(antiLagCache.shadows)

        for effect, enabled in pairs(antiLagCache.effects) do
            if effect and effect.Parent then
                pcall(function() effect.Enabled = enabled end)
            end
        end
        table.clear(antiLagCache.effects)

        for effect, enabled in pairs(antiLagCache.lighting) do
            if effect and effect.Parent then
                pcall(function() effect.Enabled = enabled end)
            end
        end
        table.clear(antiLagCache.lighting)
    end
end

