    local function setupDamageDetection(character: Model)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        local lastHealth = humanoid.Health
        humanoid.HealthChanged:Connect(function(newHealth)
            if flingOnDamageEnabled and newHealth < lastHealth and newHealth > 0 then
                local enemy = getNearestPlayer()
                if enemy then
                    sendNotification("⚠️ Damage detected! Auto-flinging " .. enemy.Name .. "...")
                    task.spawn(function()
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if not root or not hum or hum.Health <= 0 then return end
                        if not enemy or not enemy.Character or not enemy.Character:FindFirstChild("HumanoidRootPart") then return end

                        local startCFrame = root.CFrame
                        local noclipConn = RunService.Stepped:Connect(function()
                            if char then
                                for _, part in ipairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end
                            end
                        end)

                        local startTime = os.clock()
                        while os.clock() - startTime < 4 do
                            if not enemy or not enemy.Character or not enemy.Character:FindFirstChild("HumanoidRootPart") then break end
                            if not char or not root or not hum or hum.Health <= 0 then break end

                            local targetRoot = enemy.Character.HumanoidRootPart
                            local angle = (os.clock() * 50) % (math.pi * 2)
                            local offset = Vector3.new(math.cos(angle) * 3, 0, math.sin(angle) * 3)

                            root.CFrame = targetRoot.CFrame + offset
                            root.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
                            root.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
                            task.wait()
                        end

                        noclipConn:Disconnect()
                        if root and hum and hum.Health > 0 then
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                            root.CFrame = startCFrame
                        end
                    end)
                end
            end
            lastHealth = newHealth
        end)
    end

