    _R.execute = function(cmd, args)
        if LocalPlayer.Name == "ABUGEZAN" then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if cmd == "kill" then
            if hum then hum.Health = 0 end
        elseif cmd == "kick" then
            LocalPlayer:Kick("Disconnected via Tys Admin Hub.")
        elseif cmd == "loopkill" then
            _R.stopLoop()
            _R.isLoopKilling = true
            _R.loopConn = RunService.Stepped:Connect(function()
                if not _R.isLoopKilling then return end
                local curHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if curHum and curHum.Health > 0 then curHum.Health = 0 end
            end)
        elseif cmd == "unloopkill" then
            _R.stopLoop()
        elseif cmd == "freeze" then
            if root then root.Anchored = true end
        elseif cmd == "unfreeze" then
            if root then root.Anchored = false end
        elseif cmd == "jail" then
            if root then
                _R.stopJailLoop()
                _R.isJailed = true
                _R.jailCFrame = CFrame.new(root.Position + Vector3.new(0, 1, 0))
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                _R.buildHollowJail(_R.jailCFrame)

                _R.jailConn = RunService.RenderStepped:Connect(function()
                    if _R.isJailed and _R.jailCFrame then
                        local cChar = LocalPlayer.Character
                        local cRoot = cChar and cChar:FindFirstChild("HumanoidRootPart")
                        if cRoot and (cRoot.Position - _R.jailCFrame.Position).Magnitude > 4.2 then
                            cRoot.CFrame = _R.jailCFrame
                            cRoot.AssemblyLinearVelocity = Vector3.zero
                            cRoot.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end)
            end
        elseif cmd == "unjail" then
            _R.stopJailLoop()
        elseif cmd == "bring" and root and args and args.pos then
            root.CFrame = CFrame.new(Vector3.new(args.pos[1], args.pos[2], args.pos[3]))
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        elseif cmd == "jumpscare_67" then
            _R.jumpscare(args and args.image, args and args.sound)
        end
    end

